# Set these locally in .env.local and in Vercel's Environment Variables settings.
# In Vercel, enter values without the surrounding quotes used in dotenv files.
FIREBASE_PROJECT_ID=csci-teachingapp
FIREBASE_CLIENT_EMAIL=
# Paste the complete service-account private key, including its BEGIN/END lines.
# Vercel accepts actual line breaks; the server also accepts escaped \n sequences.
FIREBASE_PRIVATE_KEY=
MUSE_CODE_API=
# Optional; leave unset to use the application's default model.
# MUSE_MODEL=muse-spark-1.3
# Vercel build setting (not required for local development):
# ENABLE_EXPERIMENTAL_COREPACK=1
